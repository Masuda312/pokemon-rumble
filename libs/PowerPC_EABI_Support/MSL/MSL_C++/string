    template <class CharT, class Traits, class Allocator>
    basic_string<CharT, Traits, Allocator>
    operator+(CharT lhs, const basic_string<CharT, Traits, Allocator> &rhs);

    template <class CharT, class Traits, class Allocator>
    basic_string<CharT, Traits, Allocator>
    operator+(const basic_string<CharT, Traits, Allocator> &lhs, const CharT *rhs) {
        basic_string<CharT, Traits, Allocator> result;

        size_t rhsLength = Traits::length(rhs);
        const typename basic_string<CharT, Traits, Allocator>::rep_s& rep = lhs.m.first();

        size_t lhsLength;
        const CharT* lhsPtr;

        if (rep.is_short()) {
            lhsPtr = rep.shortBuf.buffer;
            lhsLength = rep.shortBuf.length & 0x7F;
        } else {
            lhsPtr = rep.longBuf.buffer;
            lhsLength = rep.longBuf.length;
        }

        result.reserve(lhsLength + rhsLength);

        const CharT* lhsEnd = lhsPtr + lhsLength;
        result.do_replace(0, 0, lhsPtr, lhsEnd, random_access_iterator_tag());
        result.do_replace(lhsLength, 0, rhs, rhs + rhsLength, random_access_iterator_tag());

        return result;
    }

    template <class CharT, class Traits, class Allocator>
    basic_string<CharT, Traits, Allocator>
    operator+(const basic_string<CharT, Traits, Allocator> &lhs, CharT rhs) {
        // also required to match
        random_access_iterator_tag tag;

        typedef basic_string<CharT, Traits, Allocator> str_t;

        str_t result;

        typename str_t::rep_s& rep = result.m.first();

        CharT *p;
        if (!rep.is_short()) {
            rep.longBuf.length = 1;
            p = rep.longBuf.buffer;
        } else {
            ((typename str_t::__shortlen *)&rep.shortBuf.length)->len = 1;
            p = rep.shortBuf.buffer;
        }

        p[0] = rhs;
        p[1] = CharT();

        const typename str_t::rep_s& srcRep = lhs.m.first();

        const CharT* start;
        size_t length;
            
        if (srcRep.is_short()) {
            start = srcRep.shortBuf.buffer;
            length = srcRep.shortBuf.length & 0x7F;
        } else {
            start = srcRep.longBuf.buffer;
            length = srcRep.longBuf.length;
        }

        result.do_replace(0, 0, start, start + length, tag);
        return result;
    }

